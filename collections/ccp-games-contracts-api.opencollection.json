            "params": [
              {
                "name": "character_id",
                "value": "",
                "type": "path",
                "description": "The ID of the character"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://login.eveonline.com/v2/oauth/authorize",
              "accessTokenUrl": "https://login.eveonline.com/v2/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns contracts available to a character, only if the character is issuer, acceptor or assignee. Only returns contracts no older than 30 days, or if the status is \"in_progress\"."
